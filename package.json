{
  "name": "wizard-friends",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:refresh": "node scripts/refresh-smoke.mjs",
    "test:spectator": "node scripts/spectator-smoke.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:variants": "node scripts/variant-browser-smoke.mjs",
    "test:graphics": "node scripts/graphics-smoke.mjs",
    "test:presence": "node scripts/presence-smoke.mjs",
    "test:music": "node scripts/music-smoke.mjs",
    "test:network": "node scripts/network-smoke.mjs",
    "dev:relay": "wrangler dev --ip 127.0.0.1 --port 8787",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "vite": "^6.4.4",
    "wrangler": "^4.151.3"
  }
}
